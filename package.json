{
  "name": "folder-palette",
  "version": "2.0.0",
  "description": "Customizable color palettes for the Obsidian File Explorer.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "node --test",
    "check": "npm run test && npm run build && node --check main.js",
    "preversion": "npm run check",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "folders",
    "file-explorer",
    "colors",
    "palette"
  ],
  "author": "ekozf",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekozf/folder-palette.git"
  },
  "bugs": {
    "url": "https://github.com/ekozf/folder-palette/issues"
  },
  "homepage": "https://github.com/ekozf/folder-palette#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
